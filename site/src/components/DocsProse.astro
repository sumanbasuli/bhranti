<div class="docs-prose"><slot /></div>

<script>
  document.querySelectorAll<HTMLTableElement>('.docs-prose table').forEach((table) => {
    table.tabIndex = 0;
    if (!table.hasAttribute('aria-label') && !table.caption) {
      table.setAttribute('aria-label', 'Reference table. Scroll horizontally if needed.');
    }
  });
</script>

