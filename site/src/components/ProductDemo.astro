const icon = (name: string) => `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="${paths[name]}"/></svg>`;
const id = `product-demo-${Math.random().toString(36).slice(2, 9)}`;
const stages = [{ key: 'context', label: 'Context' }, { key: 'edit', label: 'Edit' }, { key: 'review', label: 'Review' }];
---

<bhranti-product-demo data-stage="edit" data-undone="false">
  <figure class="pd-figure">
    <div class="pd-controls">
      <span class="pd-demo-label"><span class="pd-demo-mark" aria-hidden="true"></span> A small edit. The whole picture.</span>
      <div class="pd-tabs" role="tablist" aria-label="Explore the example workflow">
        {stages.map((stage, index) => (
          <button type="button" role="tab" id={`${id}-${stage.key}-tab`} aria-controls={`${id}-${stage.key}`} aria-selected={stage.key === 'edit'} tabindex={stage.key === 'edit' ? 0 : -1} data-stage-button={stage.key}>
            <span class="pd-tab-number" aria-hidden="true">0{index + 1}</span>{stage.label}
          </button>
        ))}
      </div>
    </div>

    <div class="pd-workspace">
      <div class="pd-editor" aria-hidden="true">
        <div class="pd-toolbar">
          <div class="pd-toolbar-start">
            <span class="pd-wordpress"><WordPressMark size={32} /></span>
            <span class="pd-add pd-icon" set:html={icon('plus')}></span>
            <svg class="pd-toolbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m9 5-5 5 5 5M4 10h10a6 6 0 0 1 6 6v3" /></svg>
            <svg class="pd-toolbar-icon pd-list-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6h16M4 12h12M4 18h8" /></svg>
          </div>
          <span class="pd-document-title">Home <span>· Draft</span></span>
          <div class="pd-toolbar-end"><span class="pd-saved">Saved</span><span class="pd-publish">Publish</span><span class="pd-more">⋮</span></div>
        </div>

        <div class="pd-editor-canvas">
          <div class="pd-page">
            <div class="pd-site-header"><span class="pd-studio-logo">form<span>&</span>field<span class="pd-logo-period">.</span></span><span class="pd-site-nav">The studio <span>Our work</span> Visit us ↗</span></div>
            <div class="pd-site-content">
              <div class="pd-site-copy">
                <div class="pd-site-eyebrow">INDEPENDENT CREATIVE STUDIO</div>
                <div class="pd-site-heading">Good things<br />take <em>shape.</em></div>
                <p class="pd-site-description">A space for curious minds,<br />considered design, and new beginnings.</p>
                <div class="pd-selected-block">
                  <span class="pd-block-tag">Paragraph</span>
                  <span>Our doors open <strong class="pd-date-before">17 October.</strong><strong class="pd-date-after">24 October.</strong></span>
                  <span class="pd-selection-handle"></span>
                </div>
                <div class="pd-site-link">Come say hello <span>↗</span></div>
              </div>
              <div class="pd-artwork">
                <svg viewBox="0 0 230 310" fill="none" role="presentation">
                  <path fill="#e5e0d1" d="M0 0h230v310H0z" />
                  <path fill="#d6d1c3" d="M0 240h230v70H0z" />
                  <ellipse cx="130" cy="266" rx="72" ry="13" fill="#b8b5a5" />
                  <path d="M103 183c12-32 15-71 1-111M111 139c18-16 31-34 34-60M107 119C85 102 71 94 49 94" stroke="#555c3d" stroke-width="2" />
                  <path d="M104 83C77 66 83 40 92 24c19 18 28 33 12 59Z" fill="#5b6545" />
                  <path d="M135 104c-5-25 14-45 40-46-1 26-13 43-40 46Z" fill="#65704c" />
                  <path d="M71 103C49 118 24 106 17 87c23-6 39-1 54 16Z" fill="#65704c" />
                  <path d="M89 109c-18-5-24-22-21-39 20 8 29 20 21 39Z" fill="#7b825b" />
                  <path d="M113 142c10-25 32-29 50-20-12 23-31 31-50 20Z" fill="#7b825b" />
                  <path d="M82 171h63l-5 17c-2 7 1 14 9 23 14 17 12 43-3 54H80c-15-11-17-37-3-54 8-9 11-16 9-23l-4-17Z" fill="#a04f35" />
                  <path d="M84 176h56l-4 14c-2 7 0 15 9 26 13 16 10 35-1 46H99c-9-18-10-36-3-53 6-15 3-23-12-33Z" fill="#b66647" />
                  <ellipse cx="113" cy="172" rx="31" ry="5" fill="#7b3a29" />
                  <ellipse cx="113" cy="171" rx="25" ry="2" fill="#512f26" />
                  <path d="M110 173v-29" stroke="#555c3d" stroke-width="2" />
                  <path d="M36 36v-8h8M194 274v8h-8" stroke="#9e9c8c" />
                </svg>
                <span class="pd-artwork-caption">Room to grow.</span>
              </div>
            </div>
            <div class="pd-site-footer"><span>Thoughtfully made. Open to possibility.</span><span>01 — THE BEGINNING</span></div>
          </div>
          <div class="pd-change-note"><span class="pd-icon" set:html={icon('check')}></span><span class="pd-change-copy">Opening date updated</span><span class="pd-change-detail">The rest stays yours.</span></div>
        </div>
        <div class="pd-editor-footer"><span>Page <span>›</span> Group <span>›</span> Paragraph</span><span class="pd-editor-status">Draft saved</span></div>
      </div>

      <div class="pd-sidebar">
        <div class="pd-panel-header">
          <span class="pd-panel-brand"><span class="pd-icon pd-sparkle" set:html={icon('sparkle')}></span>Bhranti</span>
          <div class="pd-header-glyphs" aria-hidden="true"><span class="pd-icon" set:html={icon('chat')}></span><span class="pd-icon" set:html={icon('plus')}></span><span class="pd-icon" set:html={icon('settings')}></span><span class="pd-icon pd-close" set:html={icon('close')}></span></div>
        </div>
        <div class="pd-conversation">
          <div class="pd-thread-name">A new beginning</div>
          <div class="pd-user-message"><span class="pd-message-label">You</span><p>Move our opening day to 24 October. Keep the tone and layout as they are.</p></div>

          <section class="pd-stage" id={`${id}-context`} role="tabpanel" tabindex="0" aria-labelledby={`${id}-context-tab`} data-stage-panel="context" hidden>
            <div class="pd-assistant-label"><span class="pd-icon" set:html={icon('sparkle')}></span>Bhranti</div>
            <p>I found the opening date on your Home page. It’s in the introduction, just above “Come say hello”.</p>
            <details class="pd-tool" open><summary><span class="pd-icon pd-check" set:html={icon('check')}></span><span>Read current page</span><span class="pd-icon pd-chevron" set:html={icon('chevron')}></span></summary><div class="pd-tool-body"><span class="pd-tool-target">Home · Paragraph block</span><p>“Our doors open 17 October.”</p></div></details>
            <p class="pd-assistant-note">The page and selected block provide the context for this edit.</p>
          </section>

          <section class="pd-stage" id={`${id}-edit`} role="tabpanel" tabindex="0" aria-labelledby={`${id}-edit-tab`} data-stage-panel="edit">
            <div class="pd-assistant-label"><span class="pd-icon" set:html={icon('sparkle')}></span>Bhranti</div>
            <p>The opening date is now <strong>24 October</strong>. Your wording and layout are unchanged, and the page is saved as a draft.</p>
            <details class="pd-tool" open><summary><span class="pd-icon pd-check" set:html={icon('check')}></span><span>Updated Home</span><span class="pd-tool-count">1 change</span><span class="pd-icon pd-chevron" set:html={icon('chevron')}></span></summary><div class="pd-tool-body"><span class="pd-tool-target">Opening date</span><div class="pd-diff"><span><span class="pd-diff-sign">−</span><del>17 October</del></span><span><span class="pd-diff-sign">+</span><ins>24 October</ins></span></div></div></details>
            <div class="pd-complete"><span class="pd-icon" set:html={icon('check')}></span>Draft saved</div>
          </section>

          <section class="pd-stage" id={`${id}-review`} role="tabpanel" tabindex="0" aria-labelledby={`${id}-review-tab`} data-stage-panel="review" hidden>
            <div class="pd-assistant-label"><span class="pd-icon" set:html={icon('sparkle')}></span>Bhranti</div>
            <p>One paragraph updated on <strong>Home</strong>. The action record keeps the change and its outcome together.</p>
            <details class="pd-tool" open><summary><span class="pd-icon pd-check" set:html={icon('check')}></span><span>Page updated</span><span class="pd-icon pd-chevron" set:html={icon('chevron')}></span></summary><div class="pd-tool-body"><span class="pd-tool-target">Home · Saved as draft</span><p class="pd-review-value">Opening day: 17 → 24 October</p><button class="pd-undo" type="button" data-undo>↶ Undo demo edit</button></div></details>
            <p class="pd-assistant-note">Try Undo to restore the original date in this preview.</p>
          </section>
        </div>
        <div class="pd-composer" aria-hidden="true">
          <div class="pd-context-chips"><span><span class="pd-icon" set:html={icon('document')}></span>Home</span><span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><path d="m8 1 6 3v8l-6 3-6-3V4l6-3Zm0 6 6-3M8 7 2 4m6 3v8" /></svg>Paragraph</span></div>
          <span class="pd-composer-placeholder">What would you like to do?</span>
          <div class="pd-composer-bottom"><span class="pd-icon" set:html={icon('plus')}></span><span class="pd-send pd-icon" set:html={icon('send')}></span></div>
        </div>
        <span class="pd-composer-note">Preview only · Explore with the tabs above</span>
      </div>
    </div>

    <span class="pd-sr-only" role="status" aria-live="polite" aria-atomic="true" data-announcement></span>
    <figcaption class="pd-caption"><span><span class="pd-caption-mark" aria-hidden="true">↳</span> Illustrative interface <span class="pd-caption-dot">·</span> Fictional sample site</span><span class="pd-stage-caption">A focused change, in the editor you know.</span></figcaption>
  </figure>
</bhranti-product-demo>

<script>
  class BhrantiProductDemo extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[data-stage-button]')];
      const panels = [...this.querySelectorAll<HTMLElement>('[data-stage-panel]')];
      const announcement = this.querySelector<HTMLElement>('[data-announcement]')!;
      const caption = this.querySelector<HTMLElement>('.pd-stage-caption')!;
      const captions: Record<string, string> = {
        context: 'Your page. Your blocks. Shared context.',
        edit: 'A focused change, in the editor you know.',
        review: 'See what changed. Restore when needed.',
      };
      const selectStage = (stage: string) => {
        this.dataset.stage = stage;
        tabs.forEach((tab) => {
          const selected = tab.dataset.stageButton === stage;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        panels.forEach((panel) => { panel.hidden = panel.dataset.stagePanel !== stage; });
        caption.textContent = captions[stage];
        if (stage === 'edit') setUndone(false);
      };
      const undoButton = this.querySelector<HTMLButtonElement>('[data-undo]')!;
      const setUndone = (undone: boolean) => {
        this.dataset.undone = String(undone);
        undoButton.textContent = undone ? '↻ Reapply demo edit' : '↶ Undo demo edit';
        this.querySelector<HTMLElement>('.pd-review-value')!.textContent = undone ? 'Opening day restored to 17 October' : 'Opening day: 17 → 24 October';
        this.querySelector<HTMLElement>('.pd-change-copy')!.textContent = undone ? 'Original date restored' : 'Opening date updated';
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectStage(tab.dataset.stageButton!));
        tab.addEventListener('keydown', (event) => {
          let next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          selectStage(tabs[next].dataset.stageButton!);
          tabs[next].focus();
        });
      });
      undoButton.addEventListener('click', () => {
        const undone = this.dataset.undone !== 'true';
        setUndone(undone);
        announcement.textContent = undone ? 'Demo edit undone. The sample opening date is 17 October.' : 'Demo edit reapplied. The sample opening date is 24 October.';
      });
    }
  }
  if (!customElements.get('bhranti-product-demo')) customElements.define('bhranti-product-demo', BhrantiProductDemo);
</script>

<style>
  bhranti-product-demo { display: block; min-width: 0; color: #f0f0f1; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 13px; font-weight: 400; line-height: 1.6; text-align: left; }
  .pd-figure, .pd-figure p { margin: 0; }
  .pd-figure *, .pd-figure *::before, .pd-figure *::after { box-sizing: border-box; }
  .pd-figure button { font: inherit; cursor: pointer; }
  .pd-figure button:focus-visible, .pd-figure summary:focus-visible, .pd-stage:focus-visible { outline: 2px solid #72aee6; outline-offset: 4px; }
  .pd-controls { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-bottom: 20px; }
  .pd-demo-label { display: flex; align-items: center; gap: 10px; font-size: 12px; color: #b4b9be; }
  .pd-demo-mark { width: 5px; height: 5px; background: #72aee6; box-shadow: 0 0 0 4px #72aee612; }
  .pd-tabs { display: flex; gap: 5px; }
  .pd-tabs button { display: flex; align-items: center; justify-content: center; gap: 9px; min-height: 40px; padding: 6px 14px; color: #b4b9be; background: transparent; border: 1px solid transparent; border-radius: 3px; transition: color 150ms, background 150ms, border-color 150ms; }
  .pd-tabs button:hover { color: #f0f0f1; background: #ffffff08; }
  .pd-tabs button[aria-selected='true'] { color: #f0f0f1; background: #2b2d2f; border-color: #45494d; border-bottom-color: #72aee6; }
  .pd-tab-number { color: #8c8f94; font-size: 10px; font-variant-numeric: tabular-nums; }
  .pd-tabs button[aria-selected='true'] .pd-tab-number { color: #72aee6; }
  .pd-workspace { display: grid; grid-template-columns: minmax(0, 1fr) 350px; overflow: hidden; padding: 7px 0 7px 7px; border: 1px solid #45494d; border-radius: 14px 0 0 14px; background: #1e1e1e; box-shadow: 0 25px 70px #00000025; }
  .pd-editor { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border-radius: 8px; background: #f0f0f1; color: #1e1e1e; }
  .pd-toolbar { min-height: 59px; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-right: 15px; background: white; border-bottom: 1px solid #dddddf; }
  .pd-toolbar-start, .pd-toolbar-end { display: flex; align-items: center; gap: 15px; }
  .pd-wordpress { display: grid; place-items: center; flex-shrink: 0; height: 59px; width: 56px; color: #fff; background: #1e1e1e; }
  .pd-wordpress :global(svg) { display: block; width: 32px; height: 32px; }
  .pd-add { display: grid; place-items: center; width: 25px; height: 25px; background: #3858e9; color: white; border-radius: 2px; }
  .pd-toolbar-icon { height: 20px; width: 20px; }
  .pd-document-title { font-size: 11px; white-space: nowrap; }
  .pd-document-title span { color: #757575; }
  .pd-saved { color: #757575; font-size: 10px; }
  .pd-publish { background: #3858e9; border-radius: 2px; padding: 6px 12px; color: white; font-size: 10px; }
  .pd-more { font-size: 24px; line-height: 1; }
  .pd-editor-canvas { position: relative; display: flex; flex: 1; flex-direction: column; justify-content: center; padding: 27px 25px 35px; }
  .pd-page { position: relative; container-type: inline-size; min-width: 0; background: #f5f3eb; border: 1px solid #e2e0d9; box-shadow: 0 2px 4px #1e1e1e03; }
  .pd-site-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 30px; padding: 23px 0 19px; border-bottom: 1px solid #d8d7cc; }
  .pd-studio-logo { font-family: Georgia, 'Times New Roman', serif; font-size: 24px; font-weight: 700; letter-spacing: -1.5px; white-space: nowrap; }
  .pd-studio-logo > span { font-size: 16px; font-style: italic; font-weight: normal; padding: 0 2px; }
  .pd-studio-logo .pd-logo-period { color: #a04f35; font-size: 25px; padding: 0; }
  .pd-site-nav { display: flex; gap: 20px; font-size: 8px; white-space: nowrap; }
  .pd-site-content { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: 18px; padding: 33px 30px 32px; align-items: center; }
  .pd-site-eyebrow { font-size: 7px; font-weight: 600; letter-spacing: 1.4px; color: #6c6e5d; margin-bottom: 19px; }
  .pd-site-heading { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(30px, 7.5cqw, 59px); letter-spacing: -.065em; line-height: .99; font-weight: 400; white-space: nowrap; }
  .pd-site-heading em { color: #68704c; font-weight: 400; }
  .pd-site-description { padding-top: 21px; font-size: 9px; line-height: 1.8; color: #68695d; }
  .pd-selected-block { position: relative; margin: 21px -8px 0; padding: 11px 8px; outline: 1.5px solid #3858e9; font-size: 9px; white-space: nowrap; }
