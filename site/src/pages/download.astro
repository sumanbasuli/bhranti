---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import GitHubMark from '../components/GitHubMark.astro';
import WordPressMark from '../components/WordPressMark.astro';
import { release } from '../data/release';
---

<Base title="Download Bhranti" description="Get Bhranti for WordPress. Check the system requirements and follow the WordPress setup guide." markdownHref="/download.md" active="download" pageClass="download-page">
  <section class="download-hero" aria-labelledby="download-title">
    <div class="container">
      <div class="release-line"><span>Bhranti for WordPress</span><span>Version {release.version} <span aria-hidden="true">/</span> GPL v2 or later</span></div>
      <div class="download-main">
        <div class="download-intro">
          <h1 id="download-title">Download<br /><span class="serif">Bhranti.</span></h1>
          <p>Work on content, design, and supported site tasks, right inside WordPress.</p>
        </div>
        <div class="download-action">
          <h2>Get Bhranti.</h2>
          <p>Download the plugin ZIP, then follow the guide to install Bhranti and connect your AI provider.</p>
          <a class="download-button" href={release.downloadUrl} download>Download Bhranti ZIP <span aria-hidden="true">↓</span></a>
          <p class="download-meta"><span>Version {release.version} · Installable ZIP</span><a href={release.checksumUrl} download>SHA-256 checksum</a></p>
          <a class="hero-link" href="/docs/get-started/">Read the setup guide <Arrow /></a>
        </div>
      </div>
      <dl class="requirements" aria-label="System requirements">
        <div><dt><WordPressMark size={20} /> WordPress</dt><dd>{release.wordpress}</dd></div>
        <div><dt>PHP</dt><dd>{release.php}</dd></div>
        <div><dt>Site access</dt><dd>Administrator</dd></div>
      </dl>
    </div>
  </section>

  <section class="container install-section" aria-labelledby="install-heading">
    <div class="install-intro">
      <h2 id="install-heading">Set up in<br /><span class="serif">WordPress.</span></h2>
      <p>A regular plugin installation. A native AI connection. Then your first conversation.</p>
      <a class="text-link" href="/docs/get-started/">Full installation guide <Arrow /></a>
      <a class="text-link" href={release.repositoryUrl}>Source code on GitHub <GitHubMark /></a>
      <a class="text-link" href={release.wordpressOrgUrl}>View on WordPress.org <Arrow direction="diagonal" /></a>
    </div>
    <ol class="install-steps">
      <li><span class="step-number" aria-hidden="true">01</span><div><h3>Install the plugin.</h3><p>In WordPress, open <strong>Plugins → Add New Plugin → Upload Plugin</strong>. Choose the Bhranti ZIP, install it, and activate the plugin.</p></div></li>
      <li><span class="step-number" aria-hidden="true">02</span><div><h3>Connect your AI provider.</h3><p>Configure your provider in <strong>Settings → Connectors</strong>. Bhranti uses the native WordPress AI Client; provider configuration and credentials stay in Connectors.</p></div></li>
      <li><span class="step-number" aria-hidden="true">03</span><div><h3>Choose permissions. Start a chat.</h3><p>Review the actions enabled in Bhranti’s settings. Open Bhranti from the admin bar and start with one clear request.</p></div></li>
    </ol>
  </section>

  <section class="container download-docs" aria-labelledby="docs-heading">
    <h2 id="docs-heading">Before your first request.</h2>
    <div class="documentation-links">
      <a href="/docs/ai-and-privacy/"><h3>AI &amp; privacy</h3><p>Your messages and relevant site context go to your configured AI provider. Its terms apply. Understand what is shared before you connect.</p><Arrow direction="diagonal" /></a>
      <a href="/docs/permissions-and-undo/"><h3>Permissions &amp; Undo</h3><p>Choose the allowed actions and approve content Trash yourself. Supported changes have seven-day, conflict-safe Undo; third-party effects cannot be reversed.</p><Arrow direction="diagonal" /></a>
    </div>
  </section>
</Base>

<style>
  .download-hero { background: var(--color-accent); color: var(--color-accent-ink); padding-top: 32px; }
  .release-line { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; font-size: 13px; font-weight: 500; }
  .release-line > span:last-child { display: flex; gap: 14px; }
  .download-main { display: grid; grid-template-columns: 1.35fr 1fr; align-items: end; gap: 96px; padding-block: 75px 72px; }
  .download-intro h1 { font-size: clamp(4.5rem, 8.4vw, 7.5rem); letter-spacing: -.065em; line-height: .99; }
  .download-intro > p { max-width: 390px; margin-top: 30px; font-size: 18px; line-height: 1.55; letter-spacing: -.015em; }
  .download-action { max-width: 365px; padding-bottom: 4px; }
  .download-action h2 { font-size: 30px; letter-spacing: -.04em; }
  .download-action > p { margin-top: 17px; font-size: 16px; line-height: 1.6; }
  .download-button { display: flex; justify-content: space-between; align-items: center; gap: 22px; min-height: 58px; margin-top: 30px; padding: 15px 20px; background: var(--color-bg); border: 1px solid var(--color-bg); color: var(--color-text); text-decoration: none; font-size: 15px; font-weight: 500; transition: background-color 150ms; }
  .download-action .download-meta { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 12px; font-size: 12px; line-height: 1.6; }
  .download-meta a { display: inline-flex; align-items: center; min-height: 24px; }
  .download-button:hover { background: #333; }
  .download-button > span { font-size: 23px; line-height: 1; }
  .download-button :global(svg), .hero-link :global(svg) { flex-shrink: 0; width: 20px; height: 20px; }
  .hero-link { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; margin-top: 10px; font-size: 14px; text-decoration: none; }
  .hero-link:hover { text-decoration: underline; text-decoration-color: currentColor; }
  .download-hero :focus-visible { outline-color: var(--color-accent-ink); }
  .requirements { display: flex; flex-wrap: wrap; column-gap: 64px; margin: 0; border-top: 1px solid #426583; padding-block: 23px 26px; }
  .requirements > div { display: flex; align-items: center; gap: 20px; padding-block: 3px; font-size: 14px; }
  .requirements dt { display: flex; align-items: center; gap: 8px; }
  .requirements dd { margin: 0; font-weight: 600; }
  .requirements > div:last-child { margin-left: auto; }
  .install-section { display: grid; grid-template-columns: 1fr 1.2fr; gap: 110px; padding-block: 104px 100px; }
  .install-intro h2 { font-size: clamp(2.5rem, 4.2vw, 3.6rem); }
  .install-intro > p { max-width: 300px; margin-top: 27px; color: var(--color-muted); font-size: 16px; }
  .install-intro .text-link { display: flex; width: fit-content; margin-top: 14px; font-size: 14px; }
  .install-steps { margin: 0; padding: 0; list-style: none; }
  .install-steps li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 24px; padding-block: 30px; border-top: 1px solid var(--color-border); }
  .install-steps li:first-child { padding-top: 5px; border-top: 0; }
  .install-steps li:last-child { padding-bottom: 0; }
  .step-number { padding-top: 5px; color: var(--color-accent); font-size: 12px; }
  .install-steps h3 { font-size: 25px; }
  .install-steps p { margin-top: 14px; color: var(--color-muted); font-size: 15px; }
  .install-steps strong { color: var(--color-text); font-weight: 500; }
  .download-docs { border-top: 1px solid var(--color-border); padding-block: 38px 80px; }
  .download-docs > h2 { font-size: 28px; margin-bottom: 32px; }
  .documentation-links > a { display: grid; grid-template-columns: .8fr 1.2fr 24px; align-items: start; gap: 60px; padding-block: 26px; border-top: 1px solid var(--color-border); text-decoration: none; }
  .documentation-links h3 { font-size: 23px; }
  .documentation-links p { max-width: 520px; color: var(--color-muted); font-size: 14px; }
  .documentation-links :global(svg) { color: var(--color-accent); margin-top: 3px; }
  .documentation-links a:hover h3 { color: var(--color-accent); text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  @media (max-width: 1000px) {
    .download-main { gap: 55px; }
    .requirements { column-gap: 30px; }
    .requirements > div { gap: 12px; }
    .install-section { gap: 55px; }
    .documentation-links > a { gap: 35px; }
  }
  @media (max-width: 800px) {
    .download-main { grid-template-columns: 1.2fr 1fr; gap: 35px; padding-block: 62px; }
    .download-intro h1 { font-size: clamp(4rem, 9vw, 5rem); }
    .download-intro > p { font-size: 16px; max-width: 310px; }
    .download-action h2 { font-size: 26px; }
    .download-action > p { font-size: 14px; }
    .download-button { padding-inline: 15px; font-size: 14px; }
    .requirements { column-gap: 28px; }
    .requirements > div { font-size: 12px; gap: 10px; }
    .install-section { grid-template-columns: .9fr 1.2fr; gap: 40px; padding-block: 80px; }
    .install-steps li { gap: 15px; }
    .install-steps h3 { font-size: 23px; }
    .documentation-links > a { grid-template-columns: .8fr 1.2fr 20px; gap: 25px; }
  }
  @media (max-width: 640px) {
    .download-hero { padding-top: 24px; }
    .release-line { font-size: 11px; gap: 8px 15px; }
    .release-line > span:last-child { gap: 8px; }
    .download-main { grid-template-columns: 1fr; gap: 42px; padding-block: 45px 40px; }
    .download-intro h1 { font-size: clamp(3.75rem, 15vw, 5.5rem); }
    .download-intro > p { margin-top: 23px; max-width: 330px; font-size: 16px; }
    .download-action { max-width: none; padding-bottom: 0; }
    .download-action h2 { font-size: 28px; }
    .download-action > p { max-width: 390px; margin-top: 12px; font-size: 15px; }
    .download-button { min-height: 56px; margin-top: 23px; padding-inline: 18px; font-size: 15px; }
    .requirements { display: grid; gap: 0; padding-block: 15px 20px; }
    .requirements > div { justify-content: space-between; font-size: 13px; min-height: 36px; gap: 20px; }
    .requirements > div:last-child { margin-left: 0; }
    .install-section { grid-template-columns: 1fr; gap: 38px; padding-block: 62px; }
    .install-intro h2 { font-size: clamp(2.5rem, 10vw, 3.2rem); }
    .install-intro > p { margin-top: 22px; }
    .install-intro .text-link { margin-top: 13px; }
    .install-steps li { grid-template-columns: 22px minmax(0, 1fr); gap: 17px; padding-block: 27px; }
    .install-steps li:first-child { border-top: 1px solid var(--color-border); padding-top: 27px; }
    .install-steps h3 { font-size: 24px; }
    .install-steps p { font-size: 14px; }
    .download-docs { padding-block: 30px 48px; }
    .download-docs > h2 { font-size: 26px; max-width: 260px; margin-bottom: 28px; }
    .documentation-links > a { grid-template-columns: minmax(0, 1fr) 20px; gap: 13px 20px; padding-block: 26px; }
    .documentation-links h3 { font-size: 24px; }
    .documentation-links p { grid-column: 1; grid-row: 2; }
    .documentation-links :global(svg) { grid-column: 2; grid-row: 1; }
  }
</style>
