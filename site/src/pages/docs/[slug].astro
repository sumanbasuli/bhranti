---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocsNavigation from '../../components/DocsNavigation.astro';
import DocsProse from '../../components/DocsProse.astro';
export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ id }) => id !== 'index');
  return docs.map(doc => ({ params: { slug: doc.id }, props: { doc } }));
}
interface Props { doc: CollectionEntry<'docs'>; }
const { doc } = Astro.props;
const docs = (await getCollection('docs', ({ id }) => id !== 'index')).sort((a,b) => a.data.order - b.data.order);
const { Content, headings } = await render(doc);
const index = docs.findIndex(item => item.id === doc.id);
const previous = docs[index - 1];
const next = docs[index + 1];
const toc = headings.filter(heading => heading.depth === 2);
const minutes = Math.max(1, Math.ceil((doc.body || '').split(/\s+/).length / 200));
---
<Base title={`${doc.data.title} — Documentation`} description={doc.data.description} markdownHref={`/docs/${doc.id}.md`} active="docs" pageClass="docs-page">
  <div class="doc-layout">
    <DocsNavigation docs={docs} current={doc.id} />
    <div class="doc-main">
      <div class="article-meta"><a href="/docs/">Documentation</a><span aria-hidden="true">/</span><span>{doc.data.group}</span></div>
      <header class="article-header">
        <h1>{doc.data.title}</h1>
        <p>{doc.data.description}</p>
        <div class="article-tools"><span>{minutes} min read</span><a href={`/docs/${doc.id}.md`} data-llm-hint="Markdown version of this documentation">Read as Markdown <span aria-hidden="true">↗</span></a></div>
      </header>
      <article aria-label={doc.data.title}><DocsProse><Content /></DocsProse></article>
      <div class="article-end"><span class="end-mark" aria-hidden="true">✳</span><span>Made for the way you work.</span></div>
      <nav class="page-neighbors" aria-label="Other guides">
        {previous ? <a href={`/docs/${previous.id}/`}><span>← Previous</span><strong>{previous.data.title}</strong></a> : <a href="/docs/"><span>← Back to</span><strong>Documentation</strong></a>}
        {next && <a class="next" href={`/docs/${next.id}/`}><span>Next →</span><strong>{next.data.title}</strong></a>}
      </nav>
    </div>
    <aside class="toc" aria-label="On this page">{toc.length > 0 && <nav><p>On this page</p><ul>{toc.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}</aside>
  </div>
</Base>
<style>
  .doc-layout { max-width:1392px; margin:0 auto; padding:60px 40px 100px; display:grid; grid-template-columns:218px minmax(0,680px) minmax(150px,1fr); gap:56px; align-items:start; }
  .doc-main { min-width:0; }
  .article-meta { display:flex; gap:10px; align-items:center; font-size:12px; color:var(--color-muted); margin:8px 0 26px; flex-wrap:wrap; }
  .article-meta a { color:var(--color-muted); text-decoration:none; }
  .article-meta a:hover { color:var(--color-accent); }
  h1 { font-size:clamp(34px,3.3vw,46px); font-weight:550; line-height:1.1; letter-spacing:-.055em; margin:0 0 18px; color:var(--color-text); }
  .article-header > p { font-size:18px; line-height:1.65; color:var(--color-muted); margin:0; max-width:530px; }
  .article-tools { display:flex; justify-content:space-between; flex-wrap:wrap; gap:14px; font-size:12px; color:var(--color-muted); border-bottom:1px solid var(--color-border); padding:27px 0 28px; margin-bottom:33px; }
  .article-tools a { color:var(--color-accent); text-decoration:none; }
  .article-tools a span { margin-left:6px; }
  .toc { position:sticky; top:120px; max-height:calc(100dvh - 144px); overflow-y:auto; scrollbar-width:thin; padding:8px 5px 0 0; font-size:12px; }
  .toc p { color:var(--color-text); font-weight:600; margin:0 0 18px; }
  .toc ul { list-style:none; margin:0; padding:0; border-left:1px solid var(--color-border); }
  .toc a { display:block; padding:7px 0 7px 17px; color:var(--color-muted); text-decoration:none; line-height:1.5; }
  .toc a:hover { color:var(--color-accent); }
  .article-end { margin:48px 0 24px; display:flex; align-items:center; gap:10px; color:var(--color-muted); font-size:12px; }
  .end-mark { color:var(--color-accent); font-size:22px; }
  .page-neighbors { display:grid; grid-template-columns:1fr 1fr; gap:20px; border-top:1px solid var(--color-border); padding-top:24px; }
  .page-neighbors a { display:flex; flex-direction:column; gap:7px; color:var(--color-text); text-decoration:none; padding:6px 0; }
  .page-neighbors a > span { color:var(--color-muted); font-size:12px; }
  .page-neighbors strong { font-size:14px; font-weight:500; }
  .page-neighbors a:hover strong { color:var(--color-accent); }
  .page-neighbors .next { text-align:right; }
  a:focus-visible { outline:2px solid var(--color-accent); outline-offset:5px; }
  @media(max-width:1150px) { .doc-layout { grid-template-columns:200px minmax(0,680px); gap:42px; } .toc { display:none; } }
  @media(max-width:850px) { .doc-layout { grid-template-columns:1fr; padding:24px 26px 64px; gap:30px; } .doc-main { max-width:680px; width:100%; margin:auto; } .article-meta { margin-top:0; } }
  @media(max-width:420px) { .doc-layout { padding-inline:20px; } .article-header > p { font-size:16px; } .article-meta { font-size:11px; gap:7px; } .page-neighbors { gap:16px; } }
</style>
